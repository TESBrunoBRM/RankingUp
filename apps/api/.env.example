SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_backend
PORT=3001

# Para APK nativo puedes usar el origen de una futura consola web. Nunca uses
# "*" con NODE_ENV=production porque la API rechazara esa configuracion.
CORS_ORIGIN=http://localhost:8081
NODE_ENV=development
ENABLE_SWAGGER=false

# Render/Fly/Nginx: numero de proxies delante de NestJS. Vacio en local.
TRUST_PROXY=
