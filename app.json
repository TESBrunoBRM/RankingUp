{
  "expo": {
    "name": "RankingUp",
    "slug": "rankingup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101114"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brunobrm.rankingup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brunobrm.rankingup",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para escanear alimentos.",
          "cameraPermission": "La app necesita acceder a tu cámara para analizar tus comidas con Inteligencia Artificial."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RankingUp necesita acceder a tu cámara para escanear alimentos y códigos de barras.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "owner": "brunobrm",
    "extra": {
      "eas": {
        "projectId": "1b99545d-2970-4f6d-835c-3b0d47a25495"
      }
    }
  }
}
