# ---------------------------------------------------------------------------
# App Expo (EXPO_PUBLIC_*): estas variables SE EMPAQUETAN en el APK/IPA.
# Nunca pongas aqui secretos: cualquiera puede extraerlas del binario.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key
EXPO_PUBLIC_RANKINGUP_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Backend NestJS (apps/api). Solo servidor: NO exponer en el cliente.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key
# Bypassea RLS por completo. Guardala solo en el gestor de secretos del host.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_backend
PORT=3001

# Origenes permitidos, separados por comas. En produccion NUNCA uses "*".
# Ej: CORS_ORIGIN=https://rankingup.app,https://admin.rankingup.app
CORS_ORIGIN=http://localhost:8081
NODE_ENV=development
# Pon "true" para exponer Swagger en /docs fuera de desarrollo.
ENABLE_SWAGGER=false

# Numero de proxies delante de la API (Render/Fly/Nginx). Vacio = sin proxy.
TRUST_PROXY=
